# =============================================================================
# AskMyDocs AI — Environment Variables
# Copy this file to .env and fill in real values. Never commit .env.
# =============================================================================

# ---- App ----
APP_NAME=AskMyDocs AI
APP_ENV=development                # development | staging | production
APP_DEBUG=true
API_V1_PREFIX=/api/v1
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# ---- Database (PostgreSQL) ----
POSTGRES_USER=askmydocs
POSTGRES_PASSWORD=change_me
POSTGRES_DB=askmydocs
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://askmydocs:change_me@db:5432/askmydocs

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# ---- Auth / JWT ----
JWT_SECRET_KEY=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- LLM Providers ----
LLM_PROVIDER=ollama                # openai | ollama
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1

# ---- Embeddings ----
EMBEDDING_PROVIDER=huggingface     # huggingface | openai
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ---- Vector Store ----
VECTOR_STORE_PATH=./storage/vector_store
FAISS_INDEX_NAME=askmydocs_index

# ---- File Storage ----
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_SIZE_MB=25
ALLOWED_FILE_TYPES=.pdf,.docx,.txt,.md

# ---- Retrieval Pipeline ----
CHUNK_SIZE=800
CHUNK_OVERLAP=120
BM25_TOP_K=20
VECTOR_TOP_K=20
RRF_K=60
RERANK_TOP_K=5
MIN_CONFIDENCE_SCORE=0.35

# ---- Evaluation ----
RAGAS_ENABLED=true
DEEPEVAL_ENABLED=true

# ---- Logging ----
LOG_LEVEL=INFO
LOG_FORMAT=json

# ---- Frontend (Next.js public vars) ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME=AskMyDocs AI
